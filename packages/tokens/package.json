{
  "name": "@lairy/tokens",
  "version": "0.1.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./css/*": "./src/css/*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./css/*": "./dist/css/*"
    },
    "access": "public"
  },
  "scripts": {
    "generate": "node build.mjs",
    "build": "pnpm run generate && tsc -p tsconfig.build.json && node scripts/add-js-extensions.mjs && pnpm run copy-css",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "copy-css": "node -e \"import('node:fs').then((fs) => fs.cpSync('src/css', 'dist/css', { recursive: true }))\"",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "style-dictionary": "^5.5.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Lowkase/lairy.git",
    "directory": "packages/tokens"
  }
}
